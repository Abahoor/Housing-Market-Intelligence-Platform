ref table 'housing_market_intelligence_platform vw_2024_price_income_ratio_extremes'
ref table 'housing_market_intelligence_platform vw_2024_rent_extremes'
ref table 'housing_market_intelligence_platform vw_2024_rent_income_ratio_extremes'
ref table 'housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'
ref table 'housing_market_intelligence_platform vw_2024_sale_price_extremes'
