table 'housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'
	lineageTag: 8097146c-d760-4a79-936e-aea1b8bfe6b6

	measure 'Monthly Rent' = AVERAGE('housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[avg_rent])
		formatString: $#,0
		lineageTag: b797118c-71a8-400a-ab4a-ec5903630281

	measure 'Estimated Monthly Mortgage' = AVERAGE('housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[estimated_monthly_mortgage])
		formatString: $#,0
		lineageTag: c6ec05be-fcd3-47d7-bea7-769b5b0a0be2

	measure 'Renting Costs Less' = CALCULATE(DISTINCTCOUNT('housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[geo_id]), REMOVEFILTERS(), 'housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[mortgage_minus_rent] > 0)
		formatString: #,0
		lineageTag: c27c7290-0e05-46fe-9e94-e53ea1392d01

	measure 'Renting Costs More' = CALCULATE(DISTINCTCOUNT('housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[geo_id]), REMOVEFILTERS(), 'housing_market_intelligence_platform vw_2024_rent_vs_est_mortgage'[mortgage_minus_rent] < 0)
		formatString: #,0
		lineageTag: 59467b73-6a1e-413c-98c5-7ac2acd1e8c2

